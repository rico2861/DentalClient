# ═══════════════════════════════════════════════════════════════════════════
#  DENTAL — Logiciel clinique  ·  renommez ce fichier en « .env »
#  Sur Windows l'app génère ce fichier toute seule : utile surtout pour
#  l'hébergement web (Docker/Render) ou pour tout régler à la main.
# ═══════════════════════════════════════════════════════════════════════════

# ── Essentiel ────────────────────────────────────────────────────────────────
JWT_SECRET=REMPLACER_PAR_UN_SECRET_32+_CARACTERES
#  ↑ chiffre les données médicales ET les sessions : doit rester TOUJOURS la même.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ── Compte propriétaire (créé au 1er démarrage) ──────────────────────────────
OWNER_EMAIL=proprietaire@exemple.com
OWNER_PASSWORD=                     # vide = mot de passe généré + écrit dans PREMIER-DEMARRAGE.txt

# ── Données (hébergement web / volume) ───────────────────────────────────────
DATA_ROOT=                          # dossier base+documents+sauvegardes (Windows: auto = ProgramData\DENTAL ; Docker: /data)
CLINIC_TZ=America/Port-au-Prince
REQUIRE_2FA=false                   # true = double authentification imposée
KEEP_SESSIONS=false
APP_URL=                            # URL publique si hébergée (liens dans les e-mails)
# DB_DIR=   STORAGE_DIR=   BACKUP_DIR=   # dérivés de DATA_ROOT — ne forcez que si besoin

# ── Licence & plateforme SaaS ────────────────────────────────────────────────
SAAS_URL=                           # URL du backend SaaS : active l'activation en ligne + e-mails relayés
# LICENSE_PUBLIC_KEY=               # déjà embarquée dans l'app — override seulement en cas de rotation
# LICENSE_CHECK_HOURS=6             # fréquence du contrôle de révocation en ligne

# ── E-mails ──────────────────────────────────────────────────────────────────
# Priorité : SMTP de la clinique (réglé dans l'app) → Resend (ci-dessous) → relais via SAAS_URL.
RESEND_API_KEY=                     # optionnel : envoi direct Resend depuis l'app
MAIL_FROM=                          # expéditeur (ex. support@votre-domaine.ht)

# ── Sauvegarde en ligne de l'app (Supabase propre au cabinet) ────────────────
SUPABASE_SYNC=on                    # on | off
SUPABASE_URL=                       # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=               # clé service_role (Project Settings → API)
SUPABASE_DB_URL=                    # connexion Postgres directe (voir backend SaaS)
# SUPABASE_REGION=   SUPABASE_KEEP_BACKUPS=30   SUPABASE_FRESH_HOURS=24   # avancé

# ── Démo (facultatif) ────────────────────────────────────────────────────────
# DEMO_PORT=4100   DEMO_DIR=                       # instance de démonstration
