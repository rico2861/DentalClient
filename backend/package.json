{
  "name": "dental-light-backend",
  "version": "1.0.0",
  "description": "DENTAL — API et serveur (Node.js + base PostgreSQL embarquée)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/init-env.js && node scripts/setup.js",
    "migrate": "node scripts/migrate.js",
    "restaurer": "node scripts/restore-latest.js",
    "start": "node scripts/init-env.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/run.mjs",
    "demo": "node scripts/demo.js",
    "recuperation": "node scripts/recuperation.js",
    "service:installer": "node scripts/service.js installer",
    "service:desinstaller": "node scripts/service.js desinstaller",
    "service:etat": "node scripts/service.js etat",
    "service:demarrer": "node scripts/service.js demarrer",
    "service:arreter": "node scripts/service.js arreter"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  }
}
